# Replace example.com with the Cloudflare Registrar domain.
{
	email admin@example.com
}

example.com, www.example.com {
	tls /etc/iidx-scoreboard/cloudflare-origin.pem /etc/iidx-scoreboard/cloudflare-origin.key
	encode zstd gzip

	root * /opt/iidx-scoreboard/client/dist

	handle /api/* {
		reverse_proxy 127.0.0.1:8080 {
			header_up Host {host}
			header_up X-Forwarded-Host {host}
			header_up X-Forwarded-Proto {scheme}
			header_up X-Real-IP {http.request.header.CF-Connecting-IP}
		}
	}

	handle /uploads/* {
		reverse_proxy 127.0.0.1:8080 {
			header_up Host {host}
			header_up X-Forwarded-Host {host}
			header_up X-Forwarded-Proto {scheme}
			header_up X-Real-IP {http.request.header.CF-Connecting-IP}
		}
	}

	handle {
		try_files {path} /index.html
		file_server
	}
}
