# Copy this file to /etc/iidx-scoreboard/backend.env on the OCI VM.
# Keep the copied file readable only by root or the service user.

SPRING_PROFILES_ACTIVE=prod
SERVER_PORT=8080

# Cloudflare Registrar domain.
APP_DOMAIN=example.com
CORS_EXTRA_ORIGINS=https://example.com,https://www.example.com

# Oracle MySQL HeatWave Always Free.
SPRING_DATASOURCE_URL=jdbc:mysql://10.0.1.10:3306/iidx_score_board?useSSL=true&serverTimezone=UTC
SPRING_DATASOURCE_USERNAME=iidx_app
SPRING_DATASOURCE_PASSWORD=replace-with-a-strong-password
SPRING_DATASOURCE_DRIVER_CLASS_NAME=com.mysql.cj.jdbc.Driver

# Local MariaDB fallback on the same VM.
# SPRING_DATASOURCE_URL=jdbc:mariadb://127.0.0.1:3306/iidx_score_board?useSSL=false&serverTimezone=UTC
# SPRING_DATASOURCE_DRIVER_CLASS_NAME=org.mariadb.jdbc.Driver

FILE_UPLOAD_DIR=/opt/iidx-scoreboard/uploads/avatars
SESSION_COOKIE_SECURE=true
SPRING_JPA_SHOW_SQL=false
