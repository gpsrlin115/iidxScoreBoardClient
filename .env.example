# Production behind Caddy/Cloudflare uses the same-origin API path.
VITE_API_BASE_URL=/api

# Optional local override when bypassing the Vite proxy:
# VITE_API_BASE_URL=http://localhost:8080/api

# Dev only. Serves the chart feedback endpoints (tier voting + comments) from
# an in-memory stub so that UI can be exercised before the backend ships.
# Ignored outside `vite dev` — the production build cannot enable it.
# See docs/api-contract-song-feedback.md
# VITE_FEEDBACK_MOCK=1
